# =============================================================
# lakehouse-databricks — environment template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================

# ---- AWS ----
AWS_REGION=us-east-1
AWS_PROFILE=default

# ---- Source OLTP (Amazon RDS for MySQL) ----
MYSQL_HOST=<rds-endpoint-from-terraform-output>
MYSQL_PORT=3306
MYSQL_DATABASE=source_db
MYSQL_USER=pipeline_user
MYSQL_PASSWORD=pipeline_secret_2024
MYSQL_ROOT_PASSWORD=root_secret_2024

# Debezium CDC user (created by scripts/init_mysql_cdc.sql)
DEBEZIUM_MYSQL_USER=debezium
DEBEZIUM_MYSQL_PASSWORD=debezium_secret

# ---- Amazon MSK (replaces self-hosted Kafka) ----
MSK_BOOTSTRAP_BROKERS=<msk-bootstrap-brokers-from-terraform-output>
MSK_CLUSTER_ARN=<msk-cluster-arn-from-terraform-output>
KAFKA_TOPIC_ORDERS=cdc.source_db.orders
KAFKA_TOPIC_CUSTOMERS=cdc.source_db.customers

# Debezium Connect REST (self-managed on ECS, or MSK Connect console)
DEBEZIUM_CONNECT_URL=http://localhost:8083

# ---- Databricks workspace ----
DATABRICKS_HOST=https://<workspace-url>.cloud.databricks.com
DATABRICKS_TOKEN=<personal-access-token-or-use-oauth>
DATABRICKS_ACCOUNT_ID=<databricks-account-id>   # only needed if Terraform creates the workspace itself

# Unity Catalog
UC_METASTORE_NAME=lakehouse-metastore
UC_CATALOG=lakehouse
UC_BRONZE_SCHEMA=bronze
UC_SILVER_SCHEMA=silver
UC_GOLD_SCHEMA=gold
UC_STORAGE_ROOT_BUCKET=<s3-bucket-from-terraform-output>   # unity catalog external location root

# SQL Warehouse (Trino replacement — used by dbt and BI tools)
DATABRICKS_SQL_WAREHOUSE_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_SQL_WAREHOUSE_ID=<warehouse-id>

# ---- Lakehouse Federation (Trino "postgresql" catalog replacement) ----
# Points a foreign catalog at RDS so Demo 5 (federation query) still works.
FEDERATION_PG_CONNECTION_NAME=rds_processed_db
FEDERATION_PG_HOST=<rds-postgres-endpoint-if-provisioned>
FEDERATION_PG_DATABASE=processed_db

# ---- BI export targets (same as original bi_dashboards/bi_dashboard.py) ----
TABLEAU_SERVER=
TABLEAU_SITE_ID=
TABLEAU_USERNAME=admin
TABLEAU_PASSWORD=
LOOKER_API_URL=
LOOKER_CLIENT_ID=
LOOKER_CLIENT_SECRET=
POWER_BI_WORKSPACE_ID=
POWER_BI_ACCESS_TOKEN=
BI_OUTPUT_DIR=/tmp/bi_exports
